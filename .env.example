# Base de données PostgreSQL (Neon ou autre)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth – Authentification admin
# Générer un secret aléatoire : openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret-in-production"

# URL publique du site (utilisée par NextAuth et les redirections)
NEXTAUTH_URL="http://localhost:3000"

# URL publique du site (utilisée pour les liens absolus, sitemap, Stripe redirect)
NEXT_PUBLIC_SITE_URL="https://hotelducommercebellegarde.vercel.app"

# Stripe – Paiement en ligne
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend – Emails transactionnels (confirmation après paiement)
# https://resend.com — créer une clé API
RESEND_API_KEY="re_..."
#
# RESEND_FROM : NE PAS utiliser d’exemple type "reservations@tondomaine.fr" sans avoir
# ajouté et vérifié CE domaine dans Resend → erreur 403 "domain is not verified".
#
# Option A (tests rapides) : ne définissez PAS RESEND_FROM dans Vercel — l’app utilise
# alors par défaut "… <onboarding@resend.dev>" (limites Resend : voir leur doc).
#
# Option B (production) : dans Resend → Domains, ajoutez votre vrai domaine (DNS),
# puis par ex. RESEND_FROM="Hôtel du Commerce <reservations@votre-domaine-verifie.fr>"
# RESEND_FROM=
